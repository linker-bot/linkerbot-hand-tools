# SDK/vendor runtime files remain external dependencies, not repository contents.
if(NOT EXISTS "${linkerhand-legacy-cpp-sdk_INCLUDE_DIRS}/legacy/CanCallbacks.h")
    message(FATAL_ERROR "Use the maintained legacy SDK package (d47c163 or newer); v2.2.1 supplies historical tool sources, not callback adapter headers")
endif()
get_filename_component(_legacy_parent "${linkerhand-legacy-cpp-sdk_LIBRARY_DIR}" DIRECTORY)
set(_legacy_third_party "${_legacy_parent}/third_party")
if(HAND_TOOLS_LEGACY_ROOT AND EXISTS "${HAND_TOOLS_LEGACY_ROOT}/third_party")
    set(_legacy_third_party "${HAND_TOOLS_LEGACY_ROOT}/third_party")
endif()
if(WIN32)
    set(_legacy_runtime_files "$<TARGET_FILE:LinkerHand::linkerhand_legacy_cpp_sdk>")
    foreach(_dll "PCAN_Basic/x64/PCANBasic.dll" "libcanbus/windows/x64/HCanbus.dll")
        if(EXISTS "${_legacy_third_party}/${_dll}")
            list(APPEND _legacy_runtime_files "${_legacy_third_party}/${_dll}")
        endif()
    endforeach()
    if(MINGW)
        foreach(_dll libstdc++-6.dll libgcc_s_seh-1.dll)
            if(EXISTS "${linkerhand-legacy-cpp-sdk_LIBRARY_DIR}/${_dll}")
                list(APPEND _legacy_runtime_files "${linkerhand-legacy-cpp-sdk_LIBRARY_DIR}/${_dll}")
            endif()
        endforeach()
    endif()
    add_custom_target(legacy_runtime ALL
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/bin"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${_legacy_runtime_files} "${CMAKE_BINARY_DIR}/bin"
        VERBATIM)
    add_dependencies(hand_bridge legacy_runtime)
    install(FILES ${_legacy_runtime_files} DESTINATION bin)
else()
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
        set(_vendor_dir "${_legacy_third_party}/libcanbus/linux/arm64")
    else()
        set(_vendor_dir "${_legacy_third_party}/libcanbus/linux/ubuntu22")
        if(EXISTS /etc/os-release)
            file(STRINGS /etc/os-release _version REGEX "^VERSION_ID=")
            if(_version MATCHES "20\\.")
                set(_vendor_dir "${_legacy_third_party}/libcanbus/linux/ubuntu20")
            endif()
        endif()
    endif()
    if(EXISTS "${_vendor_dir}")
        target_link_options(hand_bridge PRIVATE "-Wl,-rpath-link,${_vendor_dir}")
        set_property(TARGET hand_bridge APPEND PROPERTY BUILD_RPATH "${_vendor_dir}")
    endif()
    set_property(TARGET hand_bridge APPEND PROPERTY INSTALL_RPATH
        "\$ORIGIN/../lib/linkerhand-legacy-cpp-sdk/lib;${linkerhand-legacy-cpp-sdk_LIBRARY_DIR};${_vendor_dir}")
endif()
